---
import SiteLayout from "../layouts/SiteLayout.astro";
import Landing from "../components/Landing.astro";
import LoopSteps from "../components/LoopSteps.astro";
import SpecStrip from "../components/SpecStrip.astro";
import {
  APP_NAME,
  BREW_CASK,
  INSTALL_URL,
  LICENSE_NAME,
  LICENSE_URL,
  RELEASES_URL,
  REPO_URL,
  SUBLINE,
  TAGLINE,
  VERSION,
} from "../consts";
---

<SiteLayout title={`${APP_NAME} — ${TAGLINE}`} description={SUBLINE} landing>
  <Landing />

  <div class="page">
  <section class="section section-alt what">
    <div class="wrap">
      <span class="eyebrow">what it is</span>
      <p>
        Terminal text is fine for code and miserable for prose. dreamd opens as
        its own window, shows a file tree of every markdown file in whatever
        repository you are sitting in, and renders the one you click with real
        fonts, real spacing, and syntax-highlighted code blocks.
      </p>
      <p>
        It was built for a day spent inside a terminal — tmux for windows, Neovim
        for editing, Claude Code for the rest. Existing markdown previewers dump
        you into a browser tab, which breaks the flow. This is the reading window
        that belongs in that setup.
      </p>
    </div>
  </section>

  <LoopSteps />
  <SpecStrip />

  <section class="section section-alt get">
    <div class="wrap">
      <span class="eyebrow">get it</span>
      <h2>Install</h2>
      <p class="lede">
        macOS, version {VERSION}. Apple Silicon and Intel.
      </p>
      <pre><code>brew install --cask {BREW_CASK}</code></pre>
      <p class="note">
        Puts the app in <code>/Applications</code> and <code>dreamd</code> on
        your <code>PATH</code> — one binary, so the window and the command line
        are the same program. <code>dreamd</code> opens the repo you are standing
        in, <code>dreamd notes/todo.md</code> opens a file. Like nvim.
        <code>brew upgrade --cask dreamd</code> takes you to the next release.
      </p>
      <p class="note">
        Releases are signed with a Developer ID certificate and notarised by
        Apple, so the app opens straight away however you fetched it — Homebrew,
        or a zip pulled down by the browser.
      </p>

      <span class="alt">without Homebrew</span>
      <pre><code>curl -fsSL {INSTALL_URL} | sh</code></pre>
      <p class="note">
        The same release artifact, checksum-verified before it installs, in the
        same two places. Updating means re-running the line.
      </p>
      <div class="dl">
        <a class="btn btn-primary" href={RELEASES_URL} rel="noopener noreferrer">
          Download for macOS
        </a>
        <a class="btn btn-quiet" href={REPO_URL} rel="noopener noreferrer">
          Source on GitHub
        </a>
      </div>
      <p class="note">
        Linux (x86_64) ships as an AppImage and a <code>.deb</code> on each
        release, with a PKGBUILD for Arch. Open source under the
        <a href={LICENSE_URL} rel="noopener noreferrer">{LICENSE_NAME} licence</a>.
      </p>
    </div>
  </section>
  </div>
</SiteLayout>

<style>
  .what p {
    max-width: 36em;
    color: var(--muted);
  }

  .what p + p {
    margin-top: 1.2rem;
  }

  .get h2 {
    margin-bottom: 1rem;
  }

  .get .lede {
    max-width: 34em;
  }

  /* A second eyebrow, one step quieter, marking the fallback route rather than a
     new section — so it must not read as loud as the section's own label. */
  .alt {
    display: block;
    margin-top: 2.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .alt + pre {
    margin-top: 0.9rem;
  }

  pre {
    margin-top: 1.8rem;
    padding: 1.1rem 1.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.7;
    /* Wrap rather than scroll: the clone URL is wider than a phone, and a
       hidden scroll region is a worse way to read a command than a soft wrap. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  pre code {
    background: none;
    padding: 0;
    font-size: inherit;
    color: var(--text);
  }

  .note {
    margin-top: 1.2rem;
    font-size: 0.94rem;
    color: var(--muted);
    max-width: 40em;
  }

  .dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
</style>
