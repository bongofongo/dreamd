---
import SiteLayout from "../layouts/SiteLayout.astro";
import Landing from "../components/Landing.astro";
import LoopSteps from "../components/LoopSteps.astro";
import SpecStrip from "../components/SpecStrip.astro";
import {
  APP_NAME,
  BREW_CASK,
  INSTALL_URL,
  LICENSE_NAME,
  LICENSE_URL,
  RELEASES_URL,
  REPO_URL,
  SUBLINE,
  TAGLINE,
  VERSION,
} from "../consts";
---

<SiteLayout title={`${APP_NAME} — ${TAGLINE}`} description={SUBLINE} landing>
  <Landing />

  <div class="page">
  <LoopSteps />

  <section class="section get" id="install">
    <div class="wrap">
      <span class="eyebrow">get it</span>
      <h2>Install</h2>
      <p class="lede">
        Version {VERSION}. macOS on Apple Silicon and Intel, Linux on x86_64.
        Every channel installs both halves — the window and the
        <code>dreamd</code> command — so the two can never drift apart.
      </p>

      <div class="pkg">
        <span class="alt">macOS · Homebrew</span>
        <pre><code>brew install --cask {BREW_CASK}</code></pre>
        <p class="note">
          Signed and notarised, so it opens straight away.
          <code>brew upgrade --cask dreamd</code> for the next one.
        </p>
      </div>

      <div class="pkg">
        <span class="alt">macOS or Linux · no package manager, no root</span>
        <pre><code>curl -fsSL {INSTALL_URL} | sh</code></pre>
        <p class="note">
          The release artifact, checksum-verified before it unpacks. Re-run the
          line to update.
        </p>
      </div>

      <div class="pkg">
        <span class="alt">Linux · x86_64</span>
        <pre><code>chmod +x dreamd-*.AppImage && ./dreamd-*.AppImage
sudo dpkg -i dreamd-*.deb</code></pre>
        <p class="note">
          AppImage, <code>.deb</code> and a plain tarball every release, each
          carrying the same desktop entry and icons; Arch builds from the
          PKGBUILD beside them. Nothing here is signed — the
          <code>.sha256</code> files are the integrity check.
        </p>
      </div>

      <div class="dl">
        <a class="btn btn-primary" href={RELEASES_URL} rel="noopener noreferrer">
          Download the latest release
        </a>
        <a class="btn btn-quiet" href={REPO_URL} rel="noopener noreferrer">
          Source on GitHub
        </a>
      </div>
      <p class="note">
        <code>dreamd</code> opens the repo you are standing in,
        <code>dreamd notes/todo.md</code> opens a file — like nvim. Open source
        under the
        <a href={LICENSE_URL} rel="noopener noreferrer">{LICENSE_NAME} licence</a>.
      </p>
    </div>
  </section>

  <SpecStrip />
  </div>
</SiteLayout>

<style>
  .get h2 {
    margin-bottom: 1rem;
  }

  .get .lede {
    max-width: 34em;
  }

  /* One block per channel. Each is a label, the command, and what it leaves you
     with — the command is the thing being pointed at, so it carries the accent. */
  .pkg {
    margin-top: 2.6rem;
  }

  /* A second eyebrow, one step quieter, naming the channel rather than a new
     section — so it must not read as loud as the section's own label. */
  .alt {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .alt + pre {
    margin-top: 0.9rem;
  }

  pre {
    margin-top: 1.8rem;
    padding: 1.1rem 1.25rem;
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent-dim);
    border-radius: 8px;
    font-size: 0.95rem;
    line-height: 1.8;
    /* Wrap rather than scroll: the clone URL is wider than a phone, and a
       hidden scroll region is a worse way to read a command than a soft wrap. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  pre code {
    background: none;
    padding: 0;
    font-size: inherit;
    color: var(--text);
  }

  .note {
    margin-top: 1.2rem;
    font-size: 0.94rem;
    color: var(--muted);
    max-width: 40em;
  }

  .dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
</style>
