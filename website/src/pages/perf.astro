---
import fs from "node:fs";
import path from "node:path";
import SiteLayout from "../layouts/SiteLayout.astro";
import { APP_NAME, REPO_URL, href } from "../consts";

interface PerfMetrics {
  first_paint_ms: number;
  save_to_paint_p50_ms: number;
  peak_rss_mb: number;
  appimage_mb: number;
}

interface PerfEntry {
  version: string;
  sha: string;
  date: string;
  runner: string;
  metrics: PerfMetrics;
}

interface PerfHistory {
  schema: number;
  entries: PerfEntry[];
}

// The producing script is a parallel piece of work — this file may not exist
// yet, or may exist with just one entry (today's first measurement). Both are
// normal states, not errors, so this reads defensively rather than importing
// the JSON statically (which would fail the whole build the moment the file
// is absent).
const DATA_PATH = path.join(process.cwd(), "src/data/perf-history.json");

let perf: PerfHistory | null = null;
try {
  const raw = fs.readFileSync(DATA_PATH, "utf-8");
  const parsed = JSON.parse(raw) as PerfHistory;
  if (parsed && Array.isArray(parsed.entries) && parsed.entries.length > 0) {
    perf = parsed;
  }
} catch {
  perf = null;
}

const entries = perf?.entries ?? [];
const n = entries.length;

type MetricKey = keyof PerfMetrics;

const METRICS: { key: MetricKey; label: string; unit: string; decimals: number; note: string }[] = [
  {
    key: "first_paint_ms",
    label: "Cold start",
    unit: "ms",
    decimals: 0,
    note: "launch to first paint",
  },
  {
    key: "save_to_paint_p50_ms",
    label: "Save → paint (p50)",
    unit: "ms",
    decimals: 0,
    note: "edit-save to repaint, 100 highlights",
  },
  {
    key: "peak_rss_mb",
    label: "Peak memory",
    unit: "MB",
    decimals: 1,
    note: "peak resident set size",
  },
  {
    key: "appimage_mb",
    label: "Download size",
    unit: "MB",
    decimals: 1,
    note: "the AppImage artifact",
  },
];

function fmt(v: number, decimals: number): string {
  return v.toLocaleString("en-US", {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
  });
}

// ---- chart geometry, computed once at build time, emitted as static SVG ----

const CHART_W = 320;
const CHART_H = 176;
const PAD_L = 46;
const PAD_R = 12;
const PAD_T = 20;
const PAD_B = 28;
const PLOT_W = CHART_W - PAD_L - PAD_R;
const PLOT_H = CHART_H - PAD_T - PAD_B;

interface ChartPoint {
  x: number;
  y: number;
  value: number;
  version: string;
}

interface Chart {
  linePath: string;
  areaPath: string;
  points: ChartPoint[];
  ticks: { y: number; label: string }[];
  baselineY: number;
  labelX: number;
  labelY: number;
  labelAnchor: "start" | "end";
  labelText: string;
}

function buildChart(key: MetricKey, decimals: number): Chart {
  const values = entries.map((e) => e.metrics[key]);
  const rawMin = Math.min(...values);
  const rawMax = Math.max(...values);
  const span = rawMax - rawMin || Math.max(Math.abs(rawMax), 1) * 0.1;
  const yMin = rawMin - span * 0.18;
  const yMax = rawMax + span * 0.18;
  const denom = yMax - yMin || 1;

  const xAt = (i: number) => PAD_L + (n === 1 ? PLOT_W / 2 : (PLOT_W * i) / (n - 1));
  const yAt = (v: number) => PAD_T + PLOT_H - ((v - yMin) / denom) * PLOT_H;

  const points: ChartPoint[] = values.map((v, i) => ({
    x: xAt(i),
    y: yAt(v),
    value: v,
    version: entries[i].version,
  }));

  const linePath = points
    .map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(1)},${p.y.toFixed(1)}`)
    .join(" ");

  const baselineY = PAD_T + PLOT_H;
  const first = points[0];
  const last = points[points.length - 1];
  const areaPath = `${linePath} L${last.x.toFixed(1)},${baselineY.toFixed(1)} L${first.x.toFixed(1)},${baselineY.toFixed(1)} Z`;

  const ticks = [yMax, (yMax + yMin) / 2, yMin].map((v) => ({
    y: yAt(v),
    label: fmt(v, decimals),
  }));

  // Direct-label only the current (latest) value. Flip below the point when
  // it sits near the top edge, so the label never clips out of the viewBox.
  const labelBelow = last.y < PAD_T + 16;

  return {
    linePath,
    areaPath,
    points,
    ticks,
    baselineY,
    labelX: last.x,
    labelY: labelBelow ? last.y + 16 : last.y - 10,
    labelAnchor: "end",
    labelText: fmt(last.value, decimals),
  };
}

const charts = n >= 2 ? METRICS.map((m) => ({ metric: m, chart: buildChart(m.key, m.decimals) })) : [];

const PAGE_TITLE = `${APP_NAME} — Performance history`;
const PAGE_DESC =
  "Cold start, the save-to-paint loop, memory and download size across dreamd releases, measured on one machine per build.";
---

<SiteLayout title={PAGE_TITLE} description={PAGE_DESC}>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">performance</span>
      <h1 class="display">Performance, release over release.</h1>
      <p class="lede">
        Four numbers dreamd's own perf harness produces for every release:
        cold start, the save→paint loop under 100 highlights, peak memory,
        and the size of the thing you download.
      </p>
      <p class="method">
        Each entry is one build's numbers from dreamd's own{" "}
        <code>perf/run.sh</code> — a single run, not an average across
        machines, and not a synthetic suite. CI-produced entries are measured
        on GitHub's <code>ubuntu-22.04</code> Linux runner; a manually-captured
        seed is measured on whatever machine produced it. The table below
        names the exact machine behind every row, so it's clear which is
        which. See{" "}
        <a href={`${REPO_URL}/blob/main/perf/README.md`} rel="noopener noreferrer">
          perf/README.md
        </a>{" "}
        in the repo for what each number represents and how much to trust it.
      </p>
    </div>
  </section>

  {
    n === 0 && (
      <section class="section section-alt">
        <div class="wrap">
          <p class="empty">
            No release has been measured yet. This page fills in as soon as{" "}
            <code>src/data/perf-history.json</code> gets its first entry —
            check back after the next release, or see{" "}
            <a href={`${REPO_URL}/blob/main/perf/README.md`} rel="noopener noreferrer">
              perf/README.md
            </a>{" "}
            for how the numbers are produced.
          </p>
        </div>
      </section>
    )
  }

  {
    n === 1 && (
      <section class="section section-alt">
        <div class="wrap">
          <div class="tiles">
            {METRICS.map((m) => (
              <div class="tile">
                <span class="tile-label">{m.label}</span>
                <span class="tile-value">
                  {fmt(entries[0].metrics[m.key], m.decimals)}
                  <span class="tile-unit">{m.unit}</span>
                </span>
                <span class="tile-note">{m.note}</span>
              </div>
            ))}
          </div>
          <p class="note">
            History starts here — one data point per release. There is
            nothing to trend yet; this page starts drawing a line the moment a
            second release is measured. Measured on{" "}
            <code>{entries[0].runner}</code>.
          </p>
        </div>
      </section>
    )
  }

  {
    n >= 2 && (
      <section class="section section-alt">
        <div class="wrap">
          <div class="charts">
            {charts.map(({ metric, chart }) => {
              const first = entries[0].metrics[metric.key];
              const last = entries[entries.length - 1].metrics[metric.key];
              const summary = `Line chart of ${metric.label} across ${n} releases, from ${fmt(first, metric.decimals)} to ${fmt(last, metric.decimals)} ${metric.unit}, lower is better.`;
              return (
                <div class="chart-card">
                  <div class="chart-head">
                    <h3>{metric.label}</h3>
                    <span class="chart-current">
                      {fmt(last, metric.decimals)}
                      <span class="chart-unit">{metric.unit}</span>
                    </span>
                  </div>
                  <p class="chart-note">
                    {metric.note} · lower is better
                  </p>
                  <svg
                    viewBox={`0 0 ${CHART_W} ${CHART_H}`}
                    role="img"
                    aria-label={summary}
                    class="chart-svg"
                  >
                    <title>{summary}</title>
                    {chart.ticks.map((t) => (
                      <>
                        <line
                          class="chart-grid"
                          x1={PAD_L}
                          x2={CHART_W - PAD_R}
                          y1={t.y}
                          y2={t.y}
                        />
                        <text class="chart-tick" x={PAD_L - 6} y={t.y + 3}>
                          {t.label}
                        </text>
                      </>
                    ))}
                    <path class="chart-area" d={chart.areaPath} />
                    <path class="chart-line" d={chart.linePath} />
                    {chart.points.map((p) => (
                      <circle class="chart-dot" cx={p.x} cy={p.y} r="4" />
                    ))}
                    {chart.points.map((p) => (
                      <text
                        class="chart-x"
                        x={p.x}
                        y={CHART_H - 6}
                        text-anchor="middle"
                      >
                        {p.version}
                      </text>
                    ))}
                    <text
                      class="chart-label"
                      x={chart.labelX}
                      y={chart.labelY}
                      text-anchor={chart.labelAnchor}
                    >
                      {chart.labelText}
                    </text>
                  </svg>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  {
    n >= 1 && (
      <section class="section">
        <div class="wrap">
          <h2>Every number</h2>
          <p class="lede table-lede">
            The exact values behind the charts above — no hover required.
          </p>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Version</th>
                  <th>Date</th>
                  <th>Commit</th>
                  <th>Machine</th>
                  {METRICS.map((m) => (
                    <th>
                      {m.label} <span class="th-unit">({m.unit})</span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {entries.map((e) => (
                  <tr>
                    <td class="mono">{e.version}</td>
                    <td class="mono">{e.date}</td>
                    <td class="mono">
                      <a href={`${REPO_URL}/commit/${e.sha}`} rel="noopener noreferrer">
                        {e.sha}
                      </a>
                    </td>
                    <td class="mono">{e.runner}</td>
                    {METRICS.map((m) => (
                      <td class="mono num">{fmt(e.metrics[m.key], m.decimals)}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  }
</SiteLayout>

<style>
  .display {
    margin-bottom: 1rem;
  }

  .lede {
    max-width: 40em;
  }

  .method {
    margin-top: 1.2rem;
    max-width: 40em;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .empty {
    max-width: 34em;
    color: var(--muted);
  }

  /* ---- 1-entry stat tiles ---- */

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.4rem 1.5rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .tile-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tile-value {
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .tile-unit {
    margin-left: 0.3em;
    font-size: 1rem;
    font-weight: 400;
    color: var(--muted);
  }

  .tile-note {
    font-size: 0.86rem;
    color: var(--muted);
  }

  .note {
    margin-top: 2rem;
    max-width: 36em;
    color: var(--muted);
    font-size: 0.94rem;
  }

  /* ---- small multiples ---- */

  .charts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  .chart-card {
    padding: 1.2rem 1.3rem 0.9rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .chart-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .chart-head h3 {
    font-size: 0.98rem;
  }

  .chart-current {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }

  .chart-unit {
    margin-left: 0.2em;
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--muted);
  }

  .chart-note {
    margin-top: 0.2rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .chart-svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 0.6rem;
    overflow: visible;
  }

  .chart-grid {
    stroke: var(--border);
    stroke-width: 1;
  }

  .chart-tick {
    font-family: var(--font-mono);
    font-size: 8.5px;
    fill: var(--muted);
    text-anchor: end;
  }

  .chart-x {
    font-family: var(--font-mono);
    font-size: 8.5px;
    fill: var(--muted);
  }

  .chart-area {
    fill: var(--accent);
    fill-opacity: 0.1;
    stroke: none;
  }

  .chart-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .chart-dot {
    fill: var(--accent);
    stroke: var(--panel);
    stroke-width: 2;
  }

  .chart-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    fill: var(--text);
  }

  /* ---- table ---- */

  h2 {
    margin-bottom: 0.6rem;
  }

  .table-lede {
    margin-bottom: 1.6rem;
    max-width: 34em;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  th,
  td {
    padding: 0.65rem 0.8rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
  }

  .th-unit {
    text-transform: none;
    letter-spacing: 0;
  }

  td.mono {
    font-family: var(--font-mono);
  }

  td.num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  @media (max-width: 620px) {
    .tiles,
    .charts {
      grid-template-columns: 1fr;
    }
  }
</style>
