---
const steps = [
  {
    title: "Highlight",
    body: "Select a passage while you read. It stays marked in the margin — the same yellow the app uses, because this is the app's own colour.",
  },
  {
    title: "Annotate",
    body: "Attach a question to the passage. The two travel together from here on; the quote is the evidence, the question is what you actually want to know.",
    aside: "why does this contradict the section above?",
  },
  {
    title: "Stack",
    body: "Each pair queues up. Read the whole document first, marking as you go, rather than breaking off to type every time something snags.",
  },
  {
    title: "Send",
    body: "Push the stack to the Claude Code session already running in your tmux pane — one formatted question, every quote attached, file and line numbers included.",
  },
];
---

<section class="section section-alt" id="loop">
  <div class="wrap">
    <span class="eyebrow">the loop</span>
    <h2>Highlight → annotation → stack → send</h2>
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="body">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {step.aside && <p class="aside">{step.aside}</p>}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="payoff">
      Instead of retyping quotes into a chat box one at a time, you
      <mark>read normally</mark> and ship the batch at once.
    </p>
  </div>
</section>

<style>
  h2 {
    margin-bottom: 2.6rem;
  }

  .steps {
    list-style: none;
    display: grid;
    gap: 2rem;
  }

  .steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0 1rem;
    align-items: baseline;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .body h3 {
    margin-bottom: 0.3rem;
  }

  .body p {
    color: var(--muted);
    max-width: 40em;
  }

  /* The annotation, drawn the way the app draws one: hanging off the line it
     belongs to, quieter than the thing it is about. */
  .aside {
    margin-top: 0.7rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
    font-size: 0.94rem;
    font-style: italic;
    color: var(--muted);
  }

  .payoff {
    margin-top: 2.8rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 1.1rem;
    max-width: 34em;
  }

  @media (max-width: 520px) {
    .steps li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
