// Assets-only Worker serving the dreamd site at fongo.dev/dreamd*.
// The rest of fongo.dev is paper_web — itself a Worker on a Custom Domain since
// the 2026-08 move off Vercel. A Worker route takes precedence over another
// Worker's Custom Domain, so this route still shadows just the /dreamd path.
// Assets are free and unmetered.
//
// No fongo.uk route: that zone 301s wholesale to fongo.dev
// (paper_web/redirect-worker), old /dreamd links included.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamd-web",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Slashless is canonical: /dreamd/ redirects to /dreamd, and the pages'
    // own <link rel="canonical"> is normalised to match.
    "html_handling": "drop-trailing-slash"
  },
  "routes": [{ "pattern": "fongo.dev/dreamd*", "zone_name": "fongo.dev" }]
}
